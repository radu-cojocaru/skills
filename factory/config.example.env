# Ship factory config. Copied to factory/.local/config.env by install.sh.
# Plain KEY=value, sourced by bash. Every key is optional; a missing key
# takes the default shown. Keep the file mode 600: it may hold Pushover keys.

# Whose private repos to scan. Default: the logged-in gh user.
#OWNER=

# Skip launches at or above this 5-hour usage (percent).
#SESSION_MAX_PCT=70

# Skip launches at or above this weekly usage (percent).
#WEEKLY_MAX_PCT=90

# Model for a ticket with no model:opus or model:fable label.
#DEFAULT_MODEL=sonnet

# Where repo clones live: $REPOS_DIR/<repo>.
#REPOS_DIR=$HOME

# Space-separated repo names to skip.
#EXCLUDE_REPOS=

# Where the dashboard page is written. Caddy serves it from here.
#WWW_DIR=/srv/ship-factory/www

# Pushover alerts. Without both keys, alerts are logged only.
#PUSHOVER_TOKEN=
#PUSHOVER_USER=

# A working session whose transcript has not changed for this many minutes
# counts as dead.
#STALE_MINUTES=60

# Prepended to PATH so cron finds node. Default is fnm's default alias.
#NODE_BIN_DIR=$HOME/.local/share/fnm/aliases/default/bin
